<!-- 1.42: bright: Finora's picture, the balance, the month, three buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_vivid_teal"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:id="@+id/widget_finora"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="4"
            android:adjustViewBounds="true"
            android:contentDescription="Финора"
            android:scaleType="fitCenter"
            android:src="@drawable/finora_mood_check" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="6" android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView android:id="@+id/widget_month"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF" android:textSize="12sp" android:shadowColor="#55000000" android:shadowDy="1" android:shadowRadius="4" />
            <TextView android:id="@+id/widget_balance"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end"
                android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold" android:shadowColor="#55000000" android:shadowDy="1" android:shadowRadius="4"
                android:text="—" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/widget_income"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/widget_pill_white"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="2dp" android:paddingBottom="2dp"
                    android:maxLines="1"
                    android:textColor="#FF139C5A" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/widget_expense"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_pill_white"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="2dp" android:paddingBottom="2dp"
                    android:maxLines="1"
                    android:textColor="#FFE0335A" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/widget_say"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2" android:ellipsize="end"
                android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" android:shadowColor="#55000000" android:shadowDy="1" android:shadowRadius="4" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="38dp"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_voice"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_pill_yellow" android:gravity="center"
            android:textColor="#FF1B2430" android:textSize="13sp" android:textStyle="bold"
            android:text="🎤 Сказать" />
        <TextView android:id="@+id/widget_add"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_white" android:gravity="center"
            android:textColor="#FF1B2430" android:textSize="13sp" android:textStyle="bold"
            android:text="＋ Расход" />
        <TextView android:id="@+id/widget_scan"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_white" android:gravity="center"
            android:textColor="#FF1B2430" android:textSize="13sp" android:textStyle="bold"
            android:text="📷 Скрин" />
    </LinearLayout>
</LinearLayout>
