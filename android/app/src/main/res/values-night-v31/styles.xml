<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 1.55: Android 12+ opens on an empty dark sky; the app writes «Finora». -->
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FF040A12</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <!-- 1.36: no plate behind her; she fits inside the system circle. -->
        <item name="android:windowSplashScreenIconBackgroundColor">#FF040A12</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#040A12</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
