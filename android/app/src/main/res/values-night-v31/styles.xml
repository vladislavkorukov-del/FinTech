<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 1.27: Android 12+ opens with a joyful Finora on a dark sky. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FF040A12</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/finora_splash</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#040A12</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
